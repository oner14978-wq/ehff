IMM[0] INT32 {0, -1, 0, 0}
%sMOV TEMP[0], IN[0]
FLR TEMP[0].xy, TEMP[0]
F2I TEMP[0], TEMP[0]
IMAX TEMP[0].xy, TEMP[0], IMM[0].xxxx
TXQ TEMP[1].xy, IMM[0].xxxx, SAMP[0], %s
UADD TEMP[1].xy, TEMP[1], IMM[0].yyyy
IMIN TEMP[0].xy, TEMP[0], TEMP[1]
%sTXF OUT[0].z, TEMP[0], SAMP[0], %s
TXF OUT[1].y, TEMP[0], SAMP[1], %s
END
